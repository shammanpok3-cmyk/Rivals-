local function esp_makelabel(xalign)
    local lbl = Instance.new("TextLabel");
    lbl.BackgroundTransparency = 1;
    lbl.TextColor3 = Color3.new(1, 1, 1);
    lbl.TextStrokeTransparency = 0;
    lbl.TextStrokeColor3 = Color3.new(0, 0, 0);
    lbl.TextScaled = false;
    lbl.TextSize = 9;
    lbl.FontFace = esp_mainfont;
    lbl.TextXAlignment = xalign or esp_aligncenter;
    lbl.TextYAlignment = esp_alignmid;
    lbl.Size = esp_udim2offset(60, 12);
    lbl.Visible = false;
    lbl.Parent = espgui;
    local grad = Instance.new("UIGradient");
    grad.Enabled = false;
    grad.Parent = lbl;
    return lbl;
end;

local function esp_applyTextGrad(lbl, seq, offset)
    local g = lbl:FindFirstChildOfClass("UIGradient");
    if not g then return end;
    if seq then
        g.Color = seq;
        g.Offset = offset;
        g.Enabled = true;
    else
        if g.Enabled then g.Enabled = false end;
    end;
end;

local function esp_getweapon(player)
    local viewmodels = workspace:FindFirstChild("ViewModels");
    if not viewmodels then return "None" end;
    local pname = player.Name;
    for _, child in viewmodels:GetChildren() do
        local parts = {};
        for part in child.Name:gmatch("[^-]+") do
            parts[#parts + 1] = part:match("^%s*(.-)%s*$");
        end;
        if #parts >= 2 and parts[1] == pname then return parts[2] end;
    end;
    local firstperson = viewmodels:FindFirstChild("FirstPerson");
    if firstperson then
        for _, child in firstperson:GetChildren() do
            local parts = {};
            for part in child.Name:gmatch("[^-]+") do
                parts[#parts + 1] = part:match("^%s*(.-)%s*$");
            end;
            if #parts >= 2 and parts[1] == pname then return parts[2] end;
        end;
    end;
    return "none";
end;

local function esp_getbounds(root, dist)
    local hrp2d   = camera:WorldToViewportPoint(root.Position);
    local clamped = math.min(dist, 535);
    local refpos  = root.Position + (camera.CFrame.Position - root.Position).Unit * (dist - clamped);
    local rootpos = root.Position;
    local chartop    = camera:WorldToViewportPoint(refpos + esp_v3new(0, 3, 0));
    local charbottom = camera:WorldToViewportPoint(refpos - esp_v3new(0, 1, 0));
    local charsize   = (charbottom.Y - chartop.Y) / 2;
    local w = esp_mfloor(charsize * 1.5);
    local h = esp_mfloor(charsize * 3.2);
    local actualtop = camera:WorldToViewportPoint(rootpos + esp_v3new(0, 3, 0));
    local left = esp_mfloor(hrp2d.X - charsize * 0.75);
    local top  = esp_mfloor(actualtop.Y);
    if w < 4 or h < 4 then return nil end;
    return left, top, w, h;
end;

