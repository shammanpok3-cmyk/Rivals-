local COMBAT_old_katana = katana._StartDeflecting;
katana._StartDeflecting = function(...)
    local args = {...};
    local fighter = args[1].ClientFighter;
    local player = fighter and fighter.Player;
    if (player) then
        COMBAT_deflecting[player] = true;
        task.delay(args[1].Info.DeflectDuration or 0.1, function()
            COMBAT_deflecting[player] = false;
        end);
    end;
    return COMBAT_old_katana(table.unpack(args));
end;
trove:Add(function() katana._StartDeflecting = COMBAT_old_katana end);

local COMBAT_old_gun = gun.StartShooting;
gun.StartShooting = function(controller, is_empty, debounce)
    local client_fighter = controller.ClientFighter;
    if not client_fighter.IsLocalPlayer then return COMBAT_old_gun(controller, is_empty, debounce) end;
    if not is_empty and controller:Get("Ammo") <= 0 then return false end;
    local shoot_result = { COMBAT_old_gun(controller, is_empty, debounce) };
    if client_fighter.EquippedItem then
        if SEC.guns.no_spread then shoot_result[4] = true end;
    end;
    return unpack(shoot_result);
end;
trove:Add(function() gun.StartShooting = COMBAT_old_gun end);

