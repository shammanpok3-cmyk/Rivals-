local function COMBAT_CFD(origin, part)
    local cf = part.CFrame;
    local d = {};
    d[utf8.char(1)] = {
        [utf8.char(0)] = utility:EncodeCFrame(CFrame.lookAt(origin, part.Position));
        [utf8.char(1)] = utility:EncodeCFrame(cf);
        [utf8.char(2)] = part;
        [utf8.char(3)] = utility:EncodeCFrame(cf:ToObjectSpace(CFrame.new(part.Position)));
    };
    return d;
end;

local function COMBAT_get_target_part(plr, tg)
    if not plr or not plr.Character then return nil end;
    tg = tg or SEC.silent_aim.targeting;
    if SEC.silent_aim.closest_part and tg == SEC.silent_aim.targeting then
        return COMBAT_closest_part(plr);
    end;
    return plr.Character:FindFirstChild(tg.part)
        or plr.Character:FindFirstChild("HitboxHead")
        or plr.Character:FindFirstChild("Head")
        or plr.Character:FindFirstChild("HumanoidRootPart");
end;

if COMBAT_GameplayUtility and COMBAT_GameplayUtility.GetEntitiesFromRaycast then
    local _visual = COMBAT_GameplayUtility.GetEntitiesFromRaycast;
    COMBAT_GameplayUtility.GetEntitiesFromRaycast = function(self, envID, params, origin, dir, maxDist, ...)
        if SEC.silent_aim.enable and math.random(1, 100) <= SEC.silent_aim.hit_chance then
            local t = getclosest();
            if t and t.Character then
                local part = COMBAT_get_target_part(t, SEC.silent_aim.targeting);
                if part and part:IsA("BasePart") then
                    local dist = (part.Position - origin).Magnitude;
                    dir = (part.Position - origin).Unit;
                    if dist > maxDist then maxDist = dist + 5 end;
                end
            end
        end
        return _visual(self, envID, params, origin, dir, maxDist, ...);
    end;
    trove:Add(function()
        pcall(function()
            COMBAT_GameplayUtility.GetEntitiesFromRaycast = _visual;
        end);
    end);
end

