        local function ensureFolder(path)
            if type(isfolder) ~= "function" or type(makefolder) ~= "function" then return false end
            if isfolder(path) then return true end
            local parts = {}
            for part in string.gmatch(path, "[^/\\]+") do table.insert(parts, part) end
            local built = ""
            for i = 1, #parts do
                built = (i == 1) and parts[i] or (built .. "/" .. parts[i])
                if not isfolder(built) then pcall(makefolder, built) end
            end
            return isfolder(path)
        end

        local function fsReady()
            if type(writefile) ~= "function" or type(readfile) ~= "function" or type(isfile) ~= "function" then
                if not _fsWarned then _fsWarned = true; note("no filesystem API — picks last this session only") end
                return false
            end
            local ok = ensureFolder(CFG_DIR)
            if not ok and not _fsWarned then
                _fsWarned = true
                note("could not create " .. CFG_DIR .. " — picks last this session only")
            end
            return ok
        end

        function GameVisuals.saveConfig()
            if GVConfig.GVRemember == false then return false, "remember picks is off" end
            if not fsReady() then return false, "no filesystem API" end
            local doc = { v = 1, choices = {} }
            for weapon, slot in pairs(GameVisuals.Choices) do
                local entry = nil
                for _, kind in pairs({ "Skin", "Charm", "Wrap", "Finisher" }) do
                    local sel = slot[kind]
                    if type(sel) == "table" and type(sel.Name) == "string" then
                        if entry == nil then entry = {} end
                        entry[kind] = { Name = sel.Name, Inverted = sel.Inverted == true }
                    end
                end
                if entry ~= nil then doc.choices[weapon] = entry end
            end
            local encoded = nil
            local ok, err = pcall(function()
                encoded = game:GetService("HttpService"):JSONEncode(doc)
                writefile(CFG_FILE, encoded)
            end)
            if not ok then return false, "write failed: " .. tostring(err) end
            local verified = false
            pcall(function()
                if isfile(CFG_FILE) then
                    local re = readfile(CFG_FILE)
                    if type(re) == "string" and #re > 0 then verified = true end
                end
            end)
            if not verified then return false, "write succeeded but verify failed (" .. CFG_FILE .. ")" end
            return true, nil
        end

