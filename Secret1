        btn.Image = 'rbxassetid://116765805958341';
        btn.ImageColor3 = Color3.new(1, 1, 1);
        btn.ScaleType = Enum.ScaleType.Fit;
        btn.ZIndex = 2147483647;
        btn.Parent = toggleGui;

        local corner = Instance.new('UICorner');
