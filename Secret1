                local bits = {}
                for _, kind in pairs({ "Skin", "Wrap", "Charm", "Finisher" }) do
                    local v = slot[kind]
                    if v ~= nil and v.Name ~= NONE_COSMETIC then
                        local shown = tostring(v.Name)
