local COMBAT_deflecting = {};

local function COMBAT_is_deflecting(plr) return COMBAT_deflecting[plr] end;
local function COMBAT_has_riot(plr)
    return workspace.ViewModels:FindFirstChild(plr.Name .. " - Riot Shield - Riot Shield") ~= nil;
end;
local function COMBAT_check_wall(part)
    local ray = Ray.new(camera.CFrame.Position, part.Position - camera.CFrame.Position);
    local hit_part = workspace:FindPartOnRayWithIgnoreList(ray, { local_player.Character, part.Parent });
    return not hit_part;
end;
local function COMBAT_closest_part(plr)
    local mouse_pos = Vector2.new(mouse.X, mouse.Y);
    local closest, closestp = math.huge, nil;
    for _, v in next, plr.Character:GetChildren() do
        if v:IsA("BasePart") then
            local pos, on_screen = camera:WorldToViewportPoint(v.Position);
            if on_screen then
                local dist = (mouse_pos - Vector2.new(pos.X, pos.Y)).Magnitude;
                if dist <= closest then closest = dist; closestp = v end;
            end;
        end;
    end;
    return closestp;
end;

local function getclosest()
    local tg = SEC.silent_aim.targeting;
    local closest = tg.max_distance;
    local player;
    local center = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2);
    for _, v in ipairs(players:GetPlayers()) do
        if v ~= local_player and v.Character and v.Character:FindFirstChild(tg.part) and v.Character.Humanoid.Health > 0 then
            if tg.anti_katana and COMBAT_is_deflecting(v) then continue end;
            if v:GetAttribute('TeamID') == local_player:GetAttribute('TeamID') then continue end;
            if tg.visible_only and not COMBAT_check_wall(v.Character[tg.part]) then continue end;
            if tg.riot_shield and COMBAT_has_riot(v) then continue end;
            local pos, on_screen = camera:WorldToViewportPoint(v.Character[tg.part].Position);
            if on_screen then
                local dist = (center - Vector2.new(pos.X, pos.Y)).Magnitude;
                if dist < closest and dist <= SEC.silent_aim.fov_radius then player = v; closest = dist end;
            end;
        end;
    end;
    return player;
end;

local function getclosest2()
    local tg = SEC.aimbot.targeting;
    local closest = tg.max_distance;
    local player;
    local center = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2);
    for _, v in ipairs(players:GetPlayers()) do
        if v ~= local_player and v.Character and v.Character:FindFirstChild(tg.part) and v.Character.Humanoid.Health > 0 then
            if v:GetAttribute('TeamID') == local_player:GetAttribute('TeamID') then continue end;
            if tg.anti_katana and COMBAT_is_deflecting(v) then continue end;
            if tg.visible_only and not COMBAT_check_wall(v.Character[tg.part]) then continue end;
            if tg.riot_shield and COMBAT_has_riot(v) then continue end;
            local pos, on_screen = camera:WorldToViewportPoint(v.Character[tg.part].Position);
            if on_screen then
                local dist = (center - Vector2.new(pos.X, pos.Y)).Magnitude;
                if dist < closest and dist < SEC.aimbot.fov_radius then player = v; closest = dist end;
            end;
        end;
    end;
    return player;
end;

local function COMBAT_GetMuzzlePos()
    local fp = get_first_person();
    if not fp then
        return Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2);
    end;
    for _, P in ipairs(fp:GetDescendants()) do
        if P.Name == "_muzzle" and P:IsA("Attachment") then
            local Pos = camera:WorldToViewportPoint(P.WorldPosition);
            return Vector2.new(Pos.X, Pos.Y);
        end;
    end;
    return Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2);
end;

