    hl.OutlineColor = hl_cfg.outline_color;
    hl.OutlineTransparency = hl_cfg.outline_transparency;
end;
local function vm_clear_highlights()
    for part in pairs(vm_highlights) do vm_drop_highlight(part) end;
end;

