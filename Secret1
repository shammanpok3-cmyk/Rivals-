            { BackgroundColor3 = 'SelectedTabColor', BorderColor3 = 'AccentColor' },
            { BackgroundColor3 = 'MainColor', BorderColor3 = 'OutlineColor' });
        Row.MouseButton1Click:Connect(function()
            if item.Overlay and item.Overlay.Toggle then
