local highlights = {};
local body_parts = {};

local function drop_highlight(plr)
    if highlights[plr] then
        pcall(function() highlights[plr]:Destroy() end);
        highlights[plr] = nil;
    end;
end;

local function restore_body(plr)
    local saved = body_parts[plr];
    if not saved then return end;
    for part, props in pairs(saved) do
        if part.Parent then
            part.Material = props.material;
            part.Color = props.color;
            part.Reflectance = props.reflectance;
            part.Transparency = props.transparency;
            for tex, transparency in pairs(props.textures) do
                if tex.Parent then tex.Transparency = transparency end;
            end;
        end;
    end;
    body_parts[plr] = nil;
end;

local function drop_chams(plr)
    drop_highlight(plr);
    restore_body(plr);
end;

local function clear_chams()
    for plr in pairs(highlights) do drop_highlight(plr) end;
    for plr in pairs(body_parts) do restore_body(plr) end;
end;

local function apply_highlight(plr, char)
    local hl = highlights[plr];
    if not hl or not hl.Parent then
        hl = Instance.new("Highlight");
        hl.Name = "secret_chams";
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop;
        highlights[plr] = hl;
        hl.Parent = char;
    end;
    hl.Adornee = char;
    hl.FillColor = SEC.chams.fill_color;
