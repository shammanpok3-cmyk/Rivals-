local function esp_remove(player)
    if not esp_cache[player] then return end;
    local c = esp_cache[player];
    if c.box then
        if c.box.filled  then c.box.filled:Destroy()  end;
        if c.box.square  then pcall(function() c.box.square:Remove() end)   end;
        if c.box.outline then pcall(function() c.box.outline:Remove() end)  end;
        if c.box.inline  then pcall(function() c.box.inline:Remove() end)   end;
        if c.box.glow    then c.box.glow:Destroy()    end;
    end;
    if c.text then
        if c.text.name  then c.text.name:Destroy()  end;
        if c.text.studs then c.text.studs:Destroy() end;
        if c.text.tool  then c.text.tool:Destroy()  end;
    end;
    if c.bars and c.bars.hp then
        if c.bars.hp.bg   then c.bars.hp.bg:Destroy()   end;
        if c.bars.hp.fill then c.bars.hp.fill:Destroy() end;
    end;
    if c.highlight then pcall(function() c.highlight:Destroy() end) end;
    esp_cache[player] = nil;
end;

local function esp_hide(player)
    if not esp_cache[player] then return end;
    local c = esp_cache[player];
    if c.box then
        if c.box.filled  then c.box.filled.Visible  = false end;
        if c.box.square  then c.box.square.Visible  = false end;
        if c.box.outline then c.box.outline.Visible = false end;
        if c.box.inline  then c.box.inline.Visible  = false end;
        if c.box.glow    then c.box.glow.Visible    = false end;
    end;
    if c.text then
        if c.text.name  then c.text.name.Visible  = false end;
        if c.text.studs then c.text.studs.Visible = false end;
        if c.text.tool  then c.text.tool.Visible  = false end;
    end;
    if c.bars and c.bars.hp then
        if c.bars.hp.bg   then c.bars.hp.bg.Visible   = false end;
        if c.bars.hp.fill then c.bars.hp.fill.Visible = false end;
    end;
    if c.highlight and c.highlight.Enabled then c.highlight.Enabled = false end;
end;

local function esp_update(player)
    if not esp_cache[player] then return end;
    local character = player.Character;
    if not character or not character.Parent then esp_hide(player) return end;
    local root = character:FindFirstChild("HumanoidRootPart");
    local hum  = character:FindFirstChildWhichIsA("Humanoid");
    if not root or not hum then esp_hide(player) return end;
    if hum.Health <= 0 then esp_hide(player) return end;

    local cfg = SEC.esp;

    if cfg.team_check and player:GetAttribute("TeamID") ~= nil
        and player:GetAttribute("TeamID") == local_player:GetAttribute("TeamID") then
        esp_hide(player);
        return
    end;

    local rootpos = root.Position;
    local camcf   = camera.CFrame.Position;
    local dist    = (camcf - rootpos).Magnitude;
    if dist > cfg.max_dist then esp_hide(player) return end;
    local _, onscreen = camera:WorldToViewportPoint(rootpos);
    if not onscreen then esp_hide(player) return end;

    local left, top, w, h = esp_getbounds(root, dist);
    if not left then esp_hide(player) return end;

    local c        = esp_cache[player];
    local cbox     = c.box;
    local ctext    = c.text;
    local chp      = c.bars.hp;

    local espVisible = false;
    if cfg.visible.enable then
        if (esp_tickval - (c.visT or 0)) >= 0.05 then
            local ok, seen = pcall(esp_check_wall, root);
            c.vis = ok and seen == true;
            c.visT = esp_tickval;
        end;
        espVisible = c.vis == true;
    end;
    local flashing = cfg.filled.hit_flash and (esp_tickval - (c.hitFlash or 0)) < (cfg.filled.hit_time or 0.3);

    local cfgfill  = cfg.filled;
    local cfgbox   = cfg.box;
    local cfgglow  = cfg.glow;
    local cfghp    = cfg.health;
    local cfgtxt   = cfg.text;

    if cfgfill.enable then
        local fb = cbox.filled;
        fb.Visible = true;
        fb.BackgroundTransparency = cfgfill.transparency;
        fb.Position = esp_udim2offset(left, top);
        fb.Size = esp_udim2offset(w, h);
        local fc1, fc2;
        if flashing then
            fc1, fc2 = cfg.filled.hit_color, cfg.filled.hit_color;
        elseif espVisible then
            fc1, fc2 = cfg.visible.color, cfg.visible.color;
        else
            fc1, fc2 = cfgfill.color_start, cfgfill.color_end;
        end;
        if cbox.fillC1 ~= fc1 or cbox.fillC2 ~= fc2 then
            cbox.fillC1, cbox.fillC2 = fc1, fc2;
            cbox.filledgradient.Color = esp_csnew({ esp_cskp(0, fc1), esp_cskp(1, fc2) });
        end;
        cbox.filledgradient.Rotation = cfgfill.animated and (esp_msin(esp_tickval * cfgfill.speed) * 90) + cfgfill.rotation or cfgfill.rotation;
    else
        cbox.filled.Visible = false;
    end;

    if cfg.highlight.enable and c.highlight then
        local hl = c.highlight;
        if hl.Adornee ~= character then hl.Adornee = character end;
        local hfill;
        if flashing then hfill = cfg.filled.hit_color;
        elseif espVisible then hfill = cfg.visible.color;
        else hfill = cfg.highlight.fill_color end;
        if hl.FillColor ~= hfill then hl.FillColor = hfill end;
        if hl.OutlineColor ~= cfg.highlight.outline_color then hl.OutlineColor = cfg.highlight.outline_color end;
        hl.FillTransparency = cfg.highlight.fill_transparency;
        hl.OutlineTransparency = cfg.highlight.outline_transparency;
        if not hl.Enabled then hl.Enabled = true end;
    elseif c.highlight and c.highlight.Enabled then
        c.highlight.Enabled = false;
    end;

    if cfgbox.enable then
        local sq = cbox.square;
        local ol = cbox.outline;
        local il = cbox.inline;
        if ol then
            ol.Visible   = true;
            ol.Color     = cfgbox.outline;
            ol.Position  = esp_v2new(left - 1, top - 1);
            ol.Size      = esp_v2new(w + 2, h + 2);
        end;
        if sq then
            sq.Visible   = true;
            sq.Color     = espVisible and cfg.visible.color or cfgbox.color;
            sq.Thickness = cfgbox.thickness;
            sq.Position  = esp_v2new(left, top);
            sq.Size      = esp_v2new(w, h);
        end;
        if il then
            il.Visible   = true;
            il.Color     = cfgbox.inline;
            il.Position  = esp_v2new(left + 1, top + 1);
            il.Size      = esp_v2new(w - 2, h - 2);
        end;
    else
        if cbox.outline then cbox.outline.Visible = false end;
        if cbox.square  then cbox.square.Visible  = false end;
        if cbox.inline  then cbox.inline.Visible  = false end;
    end;

    if cfgglow.enable and cfgbox.enable then
        local gl = cbox.glow;
        gl.Visible           = true;
        gl.ImageTransparency = cfgglow.transparency;
        gl.ImageColor3       = cfgglow.color_start;
        gl.Position          = esp_udim2offset(left - 21, top - 21);
        gl.Size              = esp_udim2offset(w + 42, h + 42);
        if cbox.glowC1 ~= cfgglow.color_start or cbox.glowC2 ~= cfgglow.color_end then
            cbox.glowC1, cbox.glowC2 = cfgglow.color_start, cfgglow.color_end;
            cbox.glowgradient.Color = esp_csnew({ esp_cskp(0, cfgglow.color_start), esp_cskp(1, cfgglow.color_end) });
        end;
    else
        cbox.glow.Visible = false;
    end;

    if cfghp.enable then
        local hptarget = esp_mclamp(hum.Health / esp_mmax(hum.MaxHealth, 1), 0, 1);
        local hplerp   = chp.lasthp + (hptarget - chp.lasthp) * 0.1;
        if math.abs(hplerp - chp.lasthp) > 0.001 then chp.lasthp = hplerp end;
        local fillh = esp_mceil(h * chp.lasthp);
        local barx  = left - cfghp.width - cfghp.gap;
        chp.bg.Visible  = true;
        chp.bg.Position = esp_udim2offset(barx, top);
        chp.bg.Size     = esp_udim2offset(cfghp.width, h);
        chp.fill.Visible  = true;
        chp.fill.Position = esp_udim2offset(barx, top + h - fillh);
        chp.fill.Size     = esp_udim2offset(cfghp.width, fillh);
        chp.gradient.Color = esp_csnew({
            esp_cskp(0,   cfghp.color_high),
            esp_cskp(0.5, cfghp.color_mid),
            esp_cskp(1,   cfghp.color_low)
        });
    else
        chp.bg.Visible   = false;
        chp.fill.Visible = false;
    end;

    local txtsize = cfgtxt.size;

    local textGradSeq, textFlow;
    if cfgtxt.gradient then
        textGradSeq = esp_csnew({
            esp_cskp(0, cfgtxt.gradient_color1),
            esp_cskp(0.5, cfgtxt.gradient_color2),
            esp_cskp(1, cfgtxt.gradient_color1)
        });
        textFlow = cfgtxt.flow and esp_v2new((esp_tickval * (cfgtxt.flow_speed or 1)) % 2 - 1, 0) or esp_v2new(0, 0);
    end;

    local lname = ctext.name;
    lname.Visible    = cfgtxt.name.enable;
    lname.Text       = player.Name;
    lname.TextColor3 = textGradSeq and Color3.new(1, 1, 1) or cfgtxt.name.color;
    lname.TextSize   = txtsize;
    lname.Position   = esp_udim2offset(left, top - 13);
    lname.Size       = esp_udim2offset(w, 12);
    esp_applyTextGrad(lname, textGradSeq, textFlow);

    local distm = esp_mfloor(dist * 0.28);
    if distm ~= chp.lastdist then
        chp.lastdist    = distm;
        chp.lastdiststr = esp_sfmt("%dM", distm);
    end;

    local lstuds = ctext.studs;
    lstuds.Visible    = cfgtxt.studs.enable;
    lstuds.Text       = chp.lastdiststr;
    lstuds.TextColor3 = textGradSeq and Color3.new(1, 1, 1) or cfgtxt.studs.color;
    lstuds.TextSize   = txtsize;
    lstuds.Position   = esp_udim2offset(left, top + h + 2);
    lstuds.Size       = esp_udim2offset(w, 12);
    esp_applyTextGrad(lstuds, textGradSeq, textFlow);

    local ltool = ctext.tool;
    if cfgtxt.tool.enable then
        ltool.Visible    = true;
        ltool.Text       = esp_getweapon(player);
        ltool.TextColor3 = textGradSeq and Color3.new(1, 1, 1) or cfgtxt.tool.color;
        esp_applyTextGrad(ltool, textGradSeq, textFlow);
        ltool.TextSize   = txtsize;
        local tpos = cfgtxt.tool.position;
        if tpos == "top" then
            local ty = cfgtxt.name.enable and (top - 26) or (top - 13);
            ltool.TextXAlignment = esp_aligncenter;
            ltool.Position = esp_udim2offset(left, ty);
            ltool.Size     = esp_udim2offset(w, 12);
        elseif tpos == "bottom" then
            local ty = top + h + 2;
            if cfgtxt.studs.enable then ty = ty + 13 end;
            ltool.TextXAlignment = esp_aligncenter;
            ltool.Position = esp_udim2offset(left, ty);
            ltool.Size     = esp_udim2offset(w, 12);
        else
            ltool.TextXAlignment = esp_alignleft;
            ltool.Position = esp_udim2offset(left + w + cfghp.width + cfghp.gap + 2, top);
            ltool.Size     = esp_udim2offset(50, 12);
        end;
    else
        ltool.Visible = false;
    end;
end;

for _, player in players:GetPlayers() do
    if player ~= local_player then esp_add(player) end;
end;
trove:Add(players.PlayerAdded:Connect(function(player)
    if player ~= local_player then esp_add(player) end;
end));
trove:Add(players.PlayerRemoving:Connect(function(player)
    esp_remove(player);
end));

local esp_hidden_state = false;
trove:Add(run_service.RenderStepped:Connect(LPH_NO_VIRTUALIZE(function()
    esp_tickval = tick();
    if not SEC.esp.enable then
        if not esp_hidden_state then
            esp_hidden_state = true;
            for _, player in players:GetPlayers() do
                if player ~= local_player then esp_hide(player) end;
            end;
        end;
        return;
    end;
    esp_hidden_state = false;
    for _, player in players:GetPlayers() do
        if player ~= local_player then esp_update(player) end;
    end;
end)));

trove:Add(function()
    for _, player in players:GetPlayers() do esp_remove(player) end;
    pcall(function() espgui:Destroy() end);
end);

