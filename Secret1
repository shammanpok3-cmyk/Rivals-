trove:Add(run_service.Heartbeat:Connect(LPH_NO_VIRTUALIZE(function(dt)
    local s_show = SEC.silent_aim.enable and SEC.silent_aim.show_fov;
    local a_show = SEC.aimbot.enable and SEC.aimbot.show_fov;
    if not s_show and not a_show then
        if sfov.Visible then sfov.Visible = false end;
        if afov.Visible then afov.Visible = false end;
        return;
    end;
    fov_rotation = (fov_rotation + SEC.silent_aim.fov_rotation_speed * dt) % 360;
    local scenter = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2);
    local smuzzle;
    if SEC.silent_aim.follow_target and SEC.silent_aim.follow_gunpoint then
        local t = getclosest();
        if t and t.Character and t.Character:FindFirstChild(SEC.targeting.part) then
            local pos, onscreen = camera:WorldToViewportPoint(t.Character[SEC.targeting.part].Position);
            smuzzle = onscreen and Vector2.new(pos.X, pos.Y) or COMBAT_GetMuzzlePos();
        else smuzzle = COMBAT_GetMuzzlePos() end;
    elseif SEC.silent_aim.follow_target then
        local t = getclosest();
        if t and t.Character and t.Character:FindFirstChild(SEC.targeting.part) then
            local pos, onscreen = camera:WorldToViewportPoint(t.Character[SEC.targeting.part].Position);
            smuzzle = onscreen and Vector2.new(pos.X, pos.Y) or scenter;
        else smuzzle = scenter end;
    elseif SEC.silent_aim.follow_gunpoint then smuzzle = COMBAT_GetMuzzlePos();
    else smuzzle = scenter end;

    local amuzzle;
    if SEC.aimbot.follow_target and SEC.aimbot.follow_gunpoint then
        local t = getclosest2();
        if t and t.Character and t.Character:FindFirstChild(SEC.targeting.part) then
            local pos, onscreen = camera:WorldToViewportPoint(t.Character[SEC.targeting.part].Position);
            amuzzle = onscreen and Vector2.new(pos.X, pos.Y) or COMBAT_GetMuzzlePos();
        else amuzzle = COMBAT_GetMuzzlePos() end;
    elseif SEC.aimbot.follow_target then
        local t = getclosest2();
        if t and t.Character and t.Character:FindFirstChild(SEC.targeting.part) then
            local pos, onscreen = camera:WorldToViewportPoint(t.Character[SEC.targeting.part].Position);
            amuzzle = onscreen and Vector2.new(pos.X, pos.Y) or scenter;
        else amuzzle = scenter end;
    elseif SEC.aimbot.follow_gunpoint then amuzzle = COMBAT_GetMuzzlePos();
    else amuzzle = scenter end;

    local st = math.min(dt * (1 / math.max(SEC.silent_aim.lerp, 0.001)), 1);
    local at = math.min(dt * (1 / math.max(SEC.aimbot.lerp, 0.001)), 1);
    sfov_current_pos = sfov_current_pos:Lerp(smuzzle, st);
    sfov_current_radius = sfov_current_radius + (SEC.silent_aim.fov_radius - sfov_current_radius) * st;
    afov_current_pos = afov_current_pos:Lerp(amuzzle, at);
    afov_current_radius = afov_current_radius + (SEC.aimbot.fov_radius - afov_current_radius) * at;

    sfov.Visible = SEC.silent_aim.enable and SEC.silent_aim.show_fov;
    sfov.BackgroundColor3 = SEC.silent_aim.fov_fill_color;
    sfov.BackgroundTransparency = SEC.silent_aim.show_fill and SEC.silent_aim.fov_fill_transparency or 1;
    sfov.Size = UDim2.new(0, sfov_current_radius * 2, 0, sfov_current_radius * 2);
    sfov.Position = UDim2.new(0, sfov_current_pos.X - sfov_current_radius, 0, sfov_current_pos.Y - sfov_current_radius);
    sfov.Rotation = fov_rotation;
    sfov_stroke.Color = SEC.silent_aim.fov_color;
    sfov_stroke.Transparency = SEC.silent_aim.fov_outline_transparency;
    sfov_stroke.Thickness = SEC.silent_aim.fov_thickness;
    sfov_fill_gradient.Enabled = SEC.silent_aim.show_fill;
    sfov_fill_gradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, SEC.silent_aim.fov_fill_color),
        ColorSequenceKeypoint.new(1, SEC.silent_aim.fov_fill_color2),
    });
    sfov_fill_gradient.Rotation = fov_rotation;
    sfov_stroke_gradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, SEC.silent_aim.fov_color),
        ColorSequenceKeypoint.new(1, SEC.silent_aim.fov_color2 or SEC.silent_aim.fov_color),
    });
    sfov_stroke_gradient.Rotation = fov_rotation;

    afov.Visible = SEC.aimbot.enable and SEC.aimbot.show_fov;
    afov.BackgroundColor3 = SEC.aimbot.fov_fill_color;
