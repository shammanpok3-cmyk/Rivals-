RunService.Heartbeat:Connect(function()
    SilentAimState.Target = nil
    SilentAimState.Center = nil
    local cam = getCamera()
    if cam and Config.SilentAim.Enabled then
        local sa = Config.SilentAim
        if sa.FOVFollowTarget then
            local prev = SilentAimState.Target
            if prev and prev.Character then
                local part = prev.Character:FindFirstChild(sa.Part)
                    or prev.Character:FindFirstChild("HitboxHead")
                    or prev.Character:FindFirstChild("Head")
                if part then
                    local sp, on = cam:WorldToViewportPoint(part.Position)
                    if on then
                        SilentAimState.Center = Vector2.new(sp.X, sp.Y)
                    end
                end
            end
        end
        SilentAimState.Target = getTarget(sa.FOVRadius, sa, SilentAimState)
    end

    if not Config.Aimbot.Enabled then return end
    if not cam then return end
    local ab = Config.Aimbot
    local closest = getTarget(ab.FOVRadius, ab, nil, SilentAimState.Target)
    AimbotState.Target = closest
    if not closest or not closest.Character then return end
    local targetPart = closest.Character:FindFirstChild(ab.Part)
        or closest.Character:FindFirstChild("HitboxHead")
        or closest.Character:FindFirstChild("Head")
    if not targetPart then return end

    local delta = targetPart.Position - cam.CFrame.Position
    if delta.Magnitude < 0.1 then return end
    local wantedYaw = math.atan2(-delta.X, -delta.Z)
    local wantedPitch = math.asin(math.clamp(delta.Unit.Y, -1, 1))

    local cur = getCameraRotation()
    local smooth = math.clamp(ab.Smoothing, 0.01, 1)
    setCameraRotation(Vector2.new(
        cur.X + (wantedPitch - cur.X) * smooth,
        cur.Y + (wantedYaw - cur.Y) * smooth
    ))
end)

local function triggerRay()
    local cam = getCamera()
    if not cam then return nil end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { LocalPlayer.Character }
    params.IgnoreWater = true
    local rayLen = (Config.Triggerbot.UseMaxDistance and Config.Triggerbot.MaxDistance) or 2500
    local result = Workspace:Raycast(cam.CFrame.Position, cam.CFrame.LookVector * rayLen, params)
    if not result then return nil end
    local model = result.Instance:FindFirstAncestorOfClass("Model")
    if not model then return nil end
    local hum = model:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return nil end
    local plr = Players:GetPlayerFromCharacter(model)
    if not plr then return nil end
    return plr
end

