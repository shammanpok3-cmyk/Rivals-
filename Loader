local function GetMuzzlePos()
    local cam = getCamera()
    if not cam then return Vector2.new(0, 0) end
    local firstPerson = Workspace:FindFirstChild("ViewModels") and Workspace.ViewModels:FindFirstChild("FirstPerson")
    if firstPerson then
        for _, p in next, firstPerson:GetDescendants() do
            if p.Name == "_muzzle" and p:IsA("Attachment") then
                local pos = cam:WorldToViewportPoint(p.WorldPosition)
                return Vector2.new(pos.X, pos.Y)
            end
        end
    end
    return Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
end

local function updateFOVVisual(state, cfg, followCenter)
    local cam = getCamera()
    if not cam then
        state.outline.Visible = false
        state.fill.Visible = false
        state.glow.Visible = false
        return
    end

    if not cfg.ShowFOV or not cfg.Enabled then
        state.outline.Visible = false
        state.fill.Visible = false
        state.glow.Visible = false
        return
    end
    local center
    if cfg.FOVFollowGunpoint then
        center = GetMuzzlePos()
    elseif followCenter then
        center = followCenter
    else
        center = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
    end
    local outlineColor = cfg.FOVColor
    local fillColor = cfg.FOVFillColor
    if cfg.FOVGradient then
        local alpha = (math.sin(tick() * (cfg.FOVRotationSpeed / 60)) + 1) * 0.5
        outlineColor = cfg.FOVColor:Lerp(cfg.FOVColor2, alpha)
        fillColor = cfg.FOVFillColor:Lerp(cfg.FOVFillColor2, alpha)
    end
    state.outline.Position = center
    state.outline.Radius = cfg.FOVRadius
    state.outline.Color = outlineColor
    state.outline.Thickness = cfg.FOVThickness
    state.outline.Transparency = 1 - cfg.FOVTransparency
    state.outline.Visible = true
    if cfg.FOVFill then
        state.fill.Position = center
        state.fill.Radius = cfg.FOVRadius
        state.fill.Color = fillColor
        state.fill.Transparency = 1 - cfg.FOVFillTransparency
        state.fill.Visible = true
    else
        state.fill.Visible = false
    end
    state.glow.Position = center
    state.glow.Radius = cfg.FOVRadius + 2
    state.glow.Color = outlineColor
    state.glow.Thickness = cfg.FOVThickness + 2
    state.glow.Transparency = (1 - cfg.FOVTransparency) * 0.4
    state.glow.Visible = true
end

