local function getExecutorFn(name)
    local ok, fn
    pcall(function() fn = getfenv(0)[name] end)
    if type(fn) == "function" then return fn end
    pcall(function() fn = getgenv()[name] end)
    if type(fn) == "function" then return fn end
    return nil
end

