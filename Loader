local function isEnemyModel(model)
    if not model or not model.Parent then return false end
    local plr = Players:GetPlayerFromCharacter(model)
    if plr then
        if plr == LocalPlayer then return false end
        local myTeam = LocalPlayer:GetAttribute("TeamID")
        local theirTeam = plr:GetAttribute("TeamID")
        if myTeam == nil or theirTeam == nil or myTeam ~= theirTeam then
            return true
        end
        return false
    end
    local envId = LocalPlayer:GetAttribute('EnvironmentID')
    if model:GetAttribute('EnvironmentID') == envId then
        return true
    end
    return false
end

local function findClosestEnemy(origin, maxRange)
    local best, bestDist = nil, maxRange
    local duel = rawget(SpectateController, 'CurrentDuelSubject')
    if type(duel) == 'table' then
        local duelers = rawget(duel, '_duelers_by_player')
        if type(duelers) == 'table' then
            for plr, dueler in duelers do
                if plr ~= LocalPlayer then
                    local character = plr.Character
                    if character and isEnemyModel(character) then
                        local humanoid = character:FindFirstChildOfClass('Humanoid')
                        local root = character:FindFirstChild('HumanoidRootPart')
                        if humanoid and humanoid.Health > 0 and root and root:IsA('BasePart') then
                            local dist = (root.Position - origin).Magnitude
                            if dist < bestDist then
                                bestDist = dist
                                best = root
                            end
                        end
                    end
                end
            end
        end
    end
    local enemyMap = rawget(EnemyController, '_model_to_enemy')
    if type(enemyMap) == 'table' then
        for _, enemy in enemyMap do
            if type(enemy) == 'table' then
                local model = rawget(enemy, 'Model')
                if isEnemyModel(model) then
                    local humanoid = model:FindFirstChildOfClass('Humanoid')
                    local root = model:FindFirstChild('HumanoidRootPart')
                    if humanoid and humanoid.Health > 0 and root and root:IsA('BasePart') then
                        local dist = (root.Position - origin).Magnitude
                        if dist < bestDist then
                            bestDist = dist
                            best = root
                        end
                    end
                end
            end
        end
    end
    return best
end

