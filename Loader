local CFrameCodec = {}
function CFrameCodec.encode(cf)
    local rx, ry, rz = cf:ToOrientation()
    return {['\0'] = cf.X, ['\1'] = cf.Y, ['\2'] = cf.Z, ['\3'] = rx, ['\4'] = ry, ['\5'] = rz}
end
function CFrameCodec.decode(t)
    if type(t) ~= 'table' then return nil end
    local x, y, z = t['\0'], t['\1'], t['\2']
    local rx, ry, rz = t['\3'], t['\4'], t['\5']
    if type(x) ~= 'number' or type(y) ~= 'number' or type(z) ~= 'number'
        or type(rx) ~= 'number' or type(ry) ~= 'number' or type(rz) ~= 'number' then
        return nil
    end
    return CFrame.new(x, y, z) * CFrame.fromOrientation(rx, ry, rz)
end

