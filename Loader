            local equipped = rawget(fighter, "EquippedItem")
            if equipped ~= nil then
                local name = rawget(equipped, "Name")
                if type(name) == "string" and name ~= "" then
                    return name
                end
            end
        end
    end
    if char then
        for _, v in ipairs(char:GetChildren()) do
            if v:IsA("Tool") then
                return v.Name
            end
