local deflecting = {}
local function isDeflecting(plr) return deflecting[plr] == true end
local function hasRiotShield(plr)
    return Workspace.ViewModels:FindFirstChild(plr.Name .. " - Riot Shield - Riot Shield") ~= nil
end
local function checkWall(part)
    local cam = getCamera()
    if not cam then return false end
    local ray = Ray.new(cam.CFrame.Position, part.Position - cam.CFrame.Position)
    return not Workspace:FindPartOnRayWithIgnoreList(ray, { LocalPlayer.Character, part.Parent })
end
local function getClosestPart(plr)
    local cam = getCamera()
    if not cam then return nil end
    local mousePos = Vector2.new(Mouse.X, Mouse.Y)
    local closest, closestPart = math.huge, nil
    if not plr.Character then return nil end
    for _, v in next, plr.Character:GetChildren() do
        if v:IsA("BasePart") then
            local pos, onScreen = cam:WorldToViewportPoint(v.Position)
            if onScreen then
                local dist = (mousePos - Vector2.new(pos.X, pos.Y)).Magnitude
                if dist <= closest then closest, closestPart = dist, v end
            end
        end
    end
    return closestPart
end

local SilentAimState = { Target = nil, Center = nil }
local AimbotState    = { Target = nil }

local function getTarget(fovRadius, cfg, featureState, excludeTarget)
    local cam = getCamera()
    if not cam then return nil end

    if not classAllowed(cfg.ActiveClasses, getLocalEquippedClass()) then
        return nil
    end

    local center
    if featureState and featureState.Center then
        center = featureState.Center
    else
        center = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
    end

    local target = nil
    local closest = math.huge
    local origin = cam.CFrame.Position
    local useDist = cfg.UseMaxDistance
    local maxDist = cfg.MaxDistance

    for _, v in ipairs(Players:GetPlayers()) do
        if v ~= LocalPlayer and v ~= excludeTarget and v.Character then
            local part = v.Character:FindFirstChild(cfg.Part)
                or v.Character:FindFirstChild("HitboxHead")
                or v.Character:FindFirstChild("Head")
            local hum = v.Character:FindFirstChildOfClass("Humanoid")
            if part and hum and hum.Health > 0 then
                if cfg.AntiKatana and isDeflecting(v) then continue end
                if v:GetAttribute('TeamID') == LocalPlayer:GetAttribute('TeamID') then continue end
                if cfg.VisibleOnly and not checkWall(part) then continue end
                if cfg.RiotShield and hasRiotShield(v) then continue end
                if useDist and (part.Position - origin).Magnitude > maxDist then continue end
                local pos, onScreen = cam:WorldToViewportPoint(part.Position)
                if onScreen then
                    local dist = (center - Vector2.new(pos.X, pos.Y)).Magnitude
                    if dist < closest and dist <= fovRadius then
                        target, closest = v, dist
                    end
                end
            end
        end
    end
    return target
end

