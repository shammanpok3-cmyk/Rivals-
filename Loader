local undergroundActive = false
local DESYNC_MEMBERS = {}
local ROOT_TIMEOUT = 10
local DEPTH = 5
local character = nil
local root = nil
local realCFrame = nil
local lastHeartbeat = tick()

local indexMetatable = nil
if _getrawmetatable then
    local ok, mt = pcall(_getrawmetatable, game)
    if ok and mt and mt.__index then indexMetatable = mt.__index end
end

local function track(model)
    character, root, realCFrame = model, nil, nil
    local part = model:WaitForChild('HumanoidRootPart', ROOT_TIMEOUT)
    if character == model and part and part:IsA('BasePart') then
        root = part
        realCFrame = nil
    end
end

LocalPlayer.CharacterAdded:Connect(track)
LocalPlayer.CharacterRemoving:Connect(function(model)
    if model == character then
        character, root, realCFrame = nil, nil, nil
    end
end)

if LocalPlayer.Character then
    task.spawn(track, LocalPlayer.Character)
end

if indexMetatable then
    RunService:BindToRenderStep('AntiAim.DesyncRestore', Enum.RenderPriority.Camera.Value - 1, function()
        local part, cframe = root, realCFrame
        if part and cframe then
            part.CFrame = cframe
        end
    end)

    RunService.Heartbeat:Connect(function(deltaTime)
        local now = tick()
        if now - lastHeartbeat > 0.5 then
            realCFrame = nil
            if root then
                root.AssemblyLinearVelocity = Vector3.zero
            end
        end
        lastHeartbeat = now

        local part = root
        if not part then
            realCFrame = nil
            return
        end
        local cframe = indexMetatable(part, 'CFrame')
        realCFrame = cframe
        for _, member in DESYNC_MEMBERS do
            local ok, server = pcall(member.propose, cframe, part, deltaTime)
            if not ok then
                part.CFrame = cframe
            elseif server then
                part.CFrame = server
                return
            else
                cframe = indexMetatable(part, 'CFrame')
                realCFrame = cframe
            end
        end
        realCFrame = nil
    end)
end

local undergroundDeps = {
    floor = function(from, character)
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = character and {character} or {}
        local hit = Workspace:Raycast(from, Vector3.new(0, -500, 0), params)
        return hit and hit.Position.Y or nil
    end
}

local drop = Vector3.new(0, DEPTH, 0)
local flat = CFrame.Angles(math.rad(90), 0, 0)

table.insert(DESYNC_MEMBERS, {
    order = 2,
    propose = function(real, part, deltaTime)
        if not undergroundActive then return nil end
        local position = real.Position
        local floor = undergroundDeps.floor(position, part.Parent)
        local hidden = floor and Vector3.new(position.X, floor - DEPTH, position.Z) or (position - drop)
        return CFrame.new(hidden) * flat
    end
})
table.sort(DESYNC_MEMBERS, function(a, b) return a.order < b.order end)

