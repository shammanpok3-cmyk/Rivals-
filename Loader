local VALID_CLASSES = { "Primary", "Secondary", "Melee", "Utility" }

local function classFromIndex(idx)
    if idx == 1 then return "Primary" end
    if idx == 2 then return "Secondary" end
    if idx == 3 then return "Melee" end
    if idx == 4 then return "Utility" end
    return nil
end

local function getLocalEquippedClass()
    local fighter = getLocalFighter()
    if not fighter then return nil end
    local equipped = rawget(fighter, "EquippedItem")
    if not equipped then return nil end
    local info = rawget(equipped, "Info")
    if info then
        local cls = rawget(info, "Class")
        if type(cls) == "string" then return cls end
    end
    return classFromIndex(rawget(equipped, "Index"))
end

local function classAllowed(activeSet, cls)
    if activeSet == nil then return true end
    local any = false
    for _, name in ipairs(VALID_CLASSES) do
        if activeSet[name] then any = true break end
    end
    if not any then return true end
    if cls == nil then return false end
    return activeSet[cls] == true
end

local function getEquippedWeaponName(plr, char)
    local map = rawget(fighter_controller, "_player_to_fighter")
