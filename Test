local SkyboxNames = {}
for name in pairs(SkyboxPresets) do SkyboxNames[#SkyboxNames+1] = name end
table.sort(SkyboxNames)

local skyboxData = { enabled=false, selected="None", sky_obj=nil, original_sky=nil, auto_rotate=false, rotate_speed=10, star_count=3000, sun_size=20, moon_size=11 }
local skyboxConn = nil

local function EnsureSky()
    if skyboxData.sky_obj and skyboxData.sky_obj.Parent then return skyboxData.sky_obj end
    local original = Lighting:FindFirstChildOfClass("Sky")
    if original and original.Name ~= "SecretSky" then
        skyboxData.original_sky = original
        original.Parent = nil
    else skyboxData.original_sky = nil end
    skyboxData.sky_obj = Instance.new("Sky")
    skyboxData.sky_obj.Name = "SecretSky"
    skyboxData.sky_obj.Parent = Lighting
    return skyboxData.sky_obj
end

local function RestoreOriginalSky()
    if skyboxData.sky_obj and skyboxData.sky_obj.Parent then skyboxData.sky_obj:Destroy() end
    skyboxData.sky_obj = nil
    if skyboxData.original_sky and skyboxData.original_sky.Parent == nil then skyboxData.original_sky.Parent = Lighting end
    skyboxData.original_sky = nil
end

local function ApplySkybox()
    if not skyboxData.enabled then return end
    local sky = EnsureSky()
    if not sky then return end
    local tex = SkyboxPresets[skyboxData.selected] or SkyboxPresets["None"]
    sky.SkyboxBk = tex.SkyboxBk; sky.SkyboxDn = tex.SkyboxDn
    sky.SkyboxFt = tex.SkyboxFt; sky.SkyboxLf = tex.SkyboxLf
    sky.SkyboxRt = tex.SkyboxRt; sky.SkyboxUp = tex.SkyboxUp
    sky.SunAngularSize = skyboxData.sun_size
    sky.MoonAngularSize = skyboxData.moon_size
    sky.StarCount = skyboxData.star_count
end

local SkyboxSection = tabs.visual:AddRightGroupbox("Skybox")
SkyboxSection:AddToggle("skybox_enabled", { Text="Enabled", Default=false, Callback=function(state)
    skyboxData.enabled = state
    if state then ApplySkybox()
    else
        if skyboxConn then skyboxConn:Disconnect(); skyboxConn = nil end
        RestoreOriginalSky()
    end
end })
SkyboxSection:AddDropdown("skybox_selected", { Text="Skybox", Values=SkyboxNames, Default="None", Callback=function(value) skyboxData.selected=value; ApplySkybox() end })
SkyboxSection:AddSlider("skybox_stars", { Text="Stars", Min=0, Max=5000, Default=3000, Rounding=0, Callback=function(value) skyboxData.star_count=value; ApplySkybox() end })
SkyboxSection:AddSlider("skybox_sun", { Text="Sun Size", Min=0, Max=50, Default=20, Rounding=0, Callback=function(value) skyboxData.sun_size=value; ApplySkybox() end })
SkyboxSection:AddSlider("skybox_moon", { Text="Moon Size", Min=0, Max=30, Default=11, Rounding=0, Callback=function(value) skyboxData.moon_size=value; ApplySkybox() end })
SkyboxSection:AddToggle("skybox_rotate", { Text="Auto Rotate", Default=false, Callback=function(state)
    skyboxData.auto_rotate = state
    if state then
        if skyboxConn then skyboxConn:Disconnect() end
        skyboxConn = RunService.RenderStepped:Connect(function(dt)
            if not skyboxData.enabled or not skyboxData.auto_rotate then return end
            local sky = skyboxData.sky_obj
            if sky and sky.Parent then
                sky.SkyboxOrientation = Vector3.new(0, (sky.SkyboxOrientation.Y + skyboxData.rotate_speed * dt) % 360, 0)
            end
        end)
    else
        if skyboxConn then skyboxConn:Disconnect(); skyboxConn = nil end
    end
end })
