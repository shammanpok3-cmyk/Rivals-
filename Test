    local c = VIS.trajectory
    if not c.enable then
        for i=1,32 do if trajPool[i] then trajPool[i].Transparency=1 end end
        return
    end
    if not c.all_weapons and fighter_controller then
        local local_fighter = fighter_controller.LocalFighter
        local item = local_fighter and local_fighter.EquippedItem
        local name = item and item.Name and string.lower(item.Name)
        if not (name and throwables[name]) then
            for i=1,32 do if trajPool[i] then trajPool[i].Transparency=1 end end
            return
        end
    end
    local origin = Camera.CFrame.Position
    local vel = Camera.CFrame.LookVector * c.speed + Vector3.new(0, c.arc_up, 0)
    local gravity = Vector3.new(0, -workspace.Gravity, 0)
    local pos = origin
    for i=1,32 do
        local nextPos = pos + vel * 0.07 + gravity * (0.5 * 0.07 * 0.07)
        local p = getTrajPart(i)
        p.Position=nextPos; p.Color=c.color; p.Transparency=0
        pos=nextPos; vel=vel + gravity * 0.07
    end
end)

