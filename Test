local function getWin()
    local sg = Library.ScreenGui
    if not sg then return nil end
    for _, v in ipairs(sg:GetChildren()) do
        if v:IsA("Frame") and v.Visible and v.AbsoluteSize.X > 300 then return v end
    end
end

local function applyBg(id)
    local win = getWin()
    if not win then return end
    for _, v in ipairs(win:GetChildren()) do
        if v.Name == "sbg" or v.Name == "sov" then v:Destroy() end
    end
    local img = Instance.new("ImageLabel")
    img.Name="sbg"; img.BackgroundTransparency=1; img.Image=id
    img.Size=UDim2.fromScale(1,1); img.ZIndex=0
    img.ScaleType=Enum.ScaleType.Crop; img.Parent=win
    local ov = Instance.new("Frame")
    ov.Name="sov"; ov.BackgroundColor3=Color3.new(0,0,0)
    ov.BackgroundTransparency=0.55; ov.BorderSizePixel=0
    ov.Size=UDim2.fromScale(1,1); ov.ZIndex=1; ov.Parent=win
end

local function fetchBg()
    if isfile(cached) then delfile(cached) end
    local ok, raw = pcall(game.HttpGet, game, imgUrl)
    if not ok or type(raw) ~= "string" or #raw < 200 then
        Library:Notify("bg failed", 4); return
    end
    writefile(cached, raw)
    if getcustomasset then
        applyBg(getcustomasset(cached))
        Library:Notify("bg loaded", 3)
    else
        Library:Notify("no getcustomasset", 4)
    end
end

local function stripAlpha(root)
    if not root then return end
    for _, v in ipairs(root:GetDescendants()) do
        if v:IsA("Frame") or v:IsA("ScrollingFrame") then
            if v.Name == "sbg" or v.Name == "sov" then continue end
            local s = v.AbsoluteSize
            if s.X > 120 and s.Y > 40 and v.BackgroundTransparency < 0.4 then
                v.BackgroundTransparency = 0.55
            end
        end
    end
end

local function nukeBlue(root)
    if not root then return end
    for _, v in ipairs(root:GetDescendants()) do
        if v:IsA("Frame") or v:IsA("ScrollingFrame") then
            local c = v.BackgroundColor3
            if c.B > 0.35 and c.B > c.R + 0.1 then
                local m = (c.R + c.G + c.B) / 3
                v.BackgroundColor3 = Color3.new(m*0.6, m*0.6, m*0.6)
            end
        elseif v:IsA("TextLabel") or v:IsA("TextButton") then
            local tc = v.TextColor3
            if tc.B > 0.35 and tc.B > tc.R + 0.1 then v.TextColor3 = Color3.fromRGB(200,200,200) end
            local bc = v.BackgroundColor3
            if bc.B > 0.35 and bc.B > bc.R + 0.1 then v.BackgroundColor3 = Color3.fromRGB(20,20,20) end
        elseif v:IsA("UIStroke") then
            local c = v.Color
            if c.B > 0.35 and c.B > c.R + 0.1 then v.Color = Color3.fromRGB(50,50,50) end
        elseif v:IsA("ImageLabel") or v:IsA("ImageButton") then
            local c = v.ImageColor3
            if c.B > 0.35 and c.B > c.R + 0.1 then v.ImageColor3 = Color3.fromRGB(160,160,160) end
        end
    end
end

