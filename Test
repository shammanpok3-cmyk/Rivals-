local btBox = tabs.visual:AddRightGroupbox("Bullet Tracers")
local activeTracers = 0

local function createBeam(from, to)
    if activeTracers >= 48 then return end
    activeTracers += 1
    local t = VIS.tracers
    local a = Instance.new("Part")
    a.Anchored=true; a.CanCollide=false; a.CanQuery=false; a.CanTouch=false
    a.Transparency=1; a.CFrame=CFrame.new(from); a.Parent=workspace
    local b = Instance.new("Part")
    b.Anchored=true; b.CanCollide=false; b.CanQuery=false; b.CanTouch=false
    b.Transparency=1; b.CFrame=CFrame.new(from); b.Parent=workspace
    local aa = Instance.new("Attachment", a)
    local ba = Instance.new("Attachment", b)
    local beam = Instance.new("Beam")
    beam.Color = ColorSequence.new({ ColorSequenceKeypoint.new(0,t.color_start), ColorSequenceKeypoint.new(0.5,t.color_end), ColorSequenceKeypoint.new(1,t.color_start) })
    beam.Brightness=t.glow; beam.LightEmission=t.glow; beam.LightInfluence=0
    beam.TextureSpeed=t.speed; beam.TextureLength=3; beam.FaceCamera=true
    beam.Width0=t.width0; beam.Width1=t.width1
    beam.Attachment0=aa; beam.Attachment1=ba; beam.Parent=workspace
    local dist = (to - from).Magnitude
    local unit = (to - from).Unit
    local elapsed = 0
    local conn
    conn = RunService.Heartbeat:Connect(function(dt)
        elapsed += dt
        local alpha = math.min(elapsed / 0.05, 1)
        b.CFrame = CFrame.new(from + unit * (dist * alpha))
        if elapsed >= t.life_time then
            conn:Disconnect()
            beam:Destroy(); a:Destroy(); b:Destroy()
            activeTracers = math.max(activeTracers - 1, 0)
        end
    end)
end

pcall(function()
    local tp = LocalPlayer.PlayerScripts.Modules.TracerEffect
    if not tp then return end
    local mod = require(tp)
    local old = mod.Play
    mod.Play = function(...)
        local args = {...}
        if VIS.tracers.enable and args[2] and args[2].IsLocal then
            local muzzle = args[4] and args[4].MuzzlePosition
            if muzzle and args[2].RaycastResults then
                for _, v in ipairs(args[2].RaycastResults) do
                    if v.Position then createBeam(muzzle, v.Position) end
                end
            end
            if not VIS.tracers.through_walls then return end
        end
        return old(...)
    end
end)

