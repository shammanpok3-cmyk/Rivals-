local vmcBox = tabs.visual:AddLeftGroupbox("Viewmodel Chams")
local vmTrack, vmHL = {}, {}

local function vmIsArm(p)
    local n = string.lower(p.Name)
    return n:find("arm",1,true) or n:find("hand",1,true)
end
local function vmVisible(p) return p.Transparency < 1 and p.Size.Magnitude < 40 end

local function vmStore(p)
    if not vmTrack[p] then
        vmTrack[p] = { m=p.Material, c=p.Color, r=p.Reflectance, t=p.Transparency, l=p.LocalTransparencyModifier }
    end
end
local function vmRestore(p)
    local s = vmTrack[p]
    if s and p.Parent then
        p.Material=s.m; p.Color=s.c; p.Reflectance=s.r; p.Transparency=s.t; p.LocalTransparencyModifier=s.l
    end
    vmTrack[p]=nil
end
local function vmSetHL(p, cfg)
    local h = vmHL[p]
    if not h or not h.Parent then
        h = Instance.new("Highlight")
        h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        h.Adornee = p; h.Parent = p
        vmHL[p] = h
    end
    h.FillColor=cfg.color; h.FillTransparency=cfg.transparency
    h.OutlineColor=cfg.outline_color; h.OutlineTransparency=cfg.outline_transparency
end
local function vmDropHL(p)
    if vmHL[p] then vmHL[p]:Destroy(); vmHL[p]=nil end
end

