    chRing.Visible=false; chRingO.Visible=false; chDot.Visible=false; chDotO.Visible=false; chText.Visible=false
end

RunService.RenderStepped:Connect(function(dt)
    local c = VIS.crosshair
    if not c.enable then hideCrosshair() return end
    chClock = chClock + dt
    if c.rotating then chSpin = (chSpin + c.rotating_speed * dt) % 360 end
    local rad = math.rad(c.rotation + (c.rotating and chSpin or 0))
    local cv, sv = math.cos(rad), math.sin(rad)
    local anchor = ch_anchor()

    local length, gap = c.length, c.gap
    if c.animation then
        local w = (math.sin(chClock * c.animation_speed) + 1) * 0.5
        if c.animation_mode == "breathe" then gap = gap + w * length * 0.6
        else length = length * (0.55 + w * 0.45) end
    end
    if c.spread then gap = gap + math.clamp(local_speed() * 0.12 * c.spread_scale, 0, 60) end
    local color = c.color
    if c.fade then color = c.color:Lerp(c.fade_color, (math.sin(chClock*1.5)+1)*0.5) end
    local transp = 1
    if c.shimmer then transp = 0.45 + (math.sin(chClock*c.shimmer_speed)+1)*0.5*0.55 end

    if c.style == "circle" then
        for i=1,4 do chLines[i].Visible=false; chLinesO[i].Visible=false end
        chDot.Visible=false; chDotO.Visible=false
        if c.outline then
            chRingO.Position=anchor; chRingO.Radius=length; chRingO.Color=c.outline_color
            chRingO.Thickness=c.thickness+2; chRingO.Transparency=transp; chRingO.Visible=true
        else chRingO.Visible=false end
        chRing.Position=anchor; chRing.Radius=length; chRing.Color=color
        chRing.Thickness=c.thickness; chRing.Transparency=transp; chRing.Visible=true
    elseif c.style == "dot" then
        for i=1,4 do chLines[i].Visible=false; chLinesO[i].Visible=false end
        chRing.Visible=false; chRingO.Visible=false
    else
        chRing.Visible=false; chRingO.Visible=false
        local arms
        if c.style == "t" then
            arms = { {Vector2.new(0,gap),Vector2.new(0,gap+length),"bottom_line"}, {Vector2.new(-gap,0),Vector2.new(-gap-length,0),"left_line"}, {Vector2.new(gap,0),Vector2.new(gap+length,0),"right_line"} }
        elseif c.style == "x" then
            local d = 0.7071
            arms = { {Vector2.new(-d,-d)*gap,Vector2.new(-d,-d)*(gap+length),"top_line"}, {Vector2.new(d,d)*gap,Vector2.new(d,d)*(gap+length),"bottom_line"}, {Vector2.new(-d,d)*gap,Vector2.new(-d,d)*(gap+length),"left_line"}, {Vector2.new(d,-d)*gap,Vector2.new(d,-d)*(gap+length),"right_line"} }
        else
            arms = { {Vector2.new(0,-gap),Vector2.new(0,-gap-length),"top_line"}, {Vector2.new(0,gap),Vector2.new(0,gap+length),"bottom_line"}, {Vector2.new(-gap,0),Vector2.new(-gap-length,0),"left_line"}, {Vector2.new(gap,0),Vector2.new(gap+length,0),"right_line"} }
        end
        for i=1,4 do
            local a = arms[i]; local l = chLines[i]; local o = chLinesO[i]
            if c.lines and a and c[a[3]] then
                local f, tt = a[1], a[2]
                local fr = Vector2.new(f.X*cv - f.Y*sv, f.X*sv + f.Y*cv)
                local tr = Vector2.new(tt.X*cv - tt.Y*sv, tt.X*sv + tt.Y*cv)
                local from, to = anchor + fr, anchor + tr
                if c.outline then
                    o.From=from; o.To=to; o.Color=c.outline_color
                    o.Thickness=c.thickness+2; o.Transparency=transp; o.Visible=true
                else o.Visible=false end
                l.From=from; l.To=to; l.Color=color
                l.Thickness=c.thickness; l.Transparency=transp; l.Visible=true
            else l.Visible=false; o.Visible=false end
        end
    end
    if c.dot or c.style == "dot" then
        local r = math.max(c.thickness, 1)
        if c.outline then
            chDotO.Position=anchor; chDotO.Color=c.outline_color
            chDotO.Radius=r+1; chDotO.Transparency=transp; chDotO.Visible=true
        else chDotO.Visible=false end
        chDot.Position=anchor; chDot.Color=color; chDot.Radius=r
        chDot.Transparency=transp; chDot.Visible=true
    else chDot.Visible=false; chDotO.Visible=false end

    if c.text_enable and c.text_content ~= "" then
        local tc = c.text_color
        if c.text_animation then tc = Color3.fromHSV((chClock * 0.15) % 1, 0.65, 1) end
        chText.Text = c.text_content
        chText.TextSize = c.text_size
        chText.TextColor3 = tc
        chText.TextStrokeTransparency = c.text_outline and 0 or 1
        chText.Position = UDim2.fromOffset(anchor.X, anchor.Y + gap + length + c.text_offset)
        chText.Visible = true
    else chText.Visible = false end
end)

