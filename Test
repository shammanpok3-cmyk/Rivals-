local function spawnDamageNumber(damage, worldpos)
    local c = VIS.damage_numbers
    if not c.enable or not worldpos then return end
    local sp, on = Camera:WorldToViewportPoint(worldpos)
    if not on then return end
    local lbl = Instance.new("TextLabel")
    lbl.BackgroundTransparency=1; lbl.Size=UDim2.fromOffset(140,26)
    lbl.AnchorPoint=Vector2.new(0.5,0.5)
    lbl.Position=UDim2.fromOffset(sp.X, sp.Y)
    lbl.Font=fontFromName(c.font); lbl.TextSize=c.text_size
    lbl.Text="-"..tostring(math.floor(damage + 0.5))
    lbl.TextStrokeTransparency=1; lbl.TextColor3=c.color1; lbl.ZIndex=10
    lbl.Parent=dmgGui
    local stroke = Instance.new("UIStroke", lbl)
    stroke.Thickness=1.5; stroke.Color=Color3.new(); stroke.Transparency=0.15
    local scale = Instance.new("UIScale", lbl); scale.Scale=0.5
    if c.color_type == "Gradient" then
        local grad = Instance.new("UIGradient", lbl)
        grad.Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, c.color1), ColorSequenceKeypoint.new(1, c.color2) })
        grad.Rotation = 90; lbl.TextColor3 = Color3.new(1,1,1)
    end
    local startX, startY = sp.X, sp.Y
    local jitter = math.random(-14,14)
    local start = tick()
    local conn
    conn = RunService.RenderStepped:Connect(function()
        local t = (tick() - start) / c.duration
        if t >= 1 then conn:Disconnect(); pcall(function() lbl:Destroy() end); return end
        local ease = 1 - (1-t)*(1-t)*(1-t)
        if c.color_type == "Rainbow" then lbl.TextColor3 = Color3.fromHSV((tick()*0.6)%1, 0.75, 1) end
        local s
        if t < 0.16 then s = 0.5 + (t/0.16)*0.62 else s = 1.12 - ((t-0.16)/0.84)*0.12 end
        scale.Scale = s
        local fade = t < 0.55 and 0 or (t-0.55)/0.45
        lbl.Position = UDim2.fromOffset(startX + jitter*ease, startY - c.rise*ease)
        lbl.TextTransparency = fade
        stroke.Transparency = 0.15 + 0.85*fade
    end)
end

