local chamsBox = tabs.visual:AddLeftGroupbox("Chams")
local chamsHL, chamsBody = {}, {}

local function dropChams(plr)
    if chamsHL[plr] then chamsHL[plr]:Destroy(); chamsHL[plr] = nil end
    local s = chamsBody[plr]
    if s then
        for p, d in pairs(s) do
            if p.Parent then
                p.Material = d.m; p.Color = d.c; p.Reflectance = d.r; p.Transparency = d.t
                for tex, tt in pairs(d.tex) do if tex.Parent then tex.Transparency = tt end end
            end
        end
        chamsBody[plr] = nil
    end
end

local function applyChams(plr)
    if plr == LocalPlayer then return end
    local ch = plr.Character
    if not ch then return dropChams(plr) end
    local hum = ch:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return dropChams(plr) end
    if VIS.chams.team_check and plr:GetAttribute("TeamID") == LocalPlayer:GetAttribute("TeamID") then return dropChams(plr) end
    if VIS.chams.mode == "chams" then
        if chamsHL[plr] then chamsHL[plr]:Destroy(); chamsHL[plr] = nil end
        chamsBody[plr] = chamsBody[plr] or {}
        for _, p in ipairs(ch:GetDescendants()) do
            if p:IsA("BasePart") and p.Transparency < 1 and not p.Name:find("Hitbox") then
                if not chamsBody[plr][p] then
                    local tex = {}
                    for _, tt in ipairs(p:GetChildren()) do
                        if tt:IsA("Decal") or tt:IsA("Texture") then tex[tt] = tt.Transparency end
                    end
                    chamsBody[plr][p] = { m=p.Material, c=p.Color, r=p.Reflectance, t=p.Transparency, tex=tex }
                end
                p.Material = Enum.Material[VIS.chams.material] or Enum.Material.Neon
                p.Color = VIS.chams.fill_color
                p.Reflectance = 0
                p.Transparency = VIS.chams.ghost and math.max(0.55, VIS.chams.fill_transparency) or VIS.chams.fill_transparency
                if VIS.chams.strip_textures then
                    for tex in pairs(chamsBody[plr][p].tex) do if tex.Parent then tex.Transparency = 1 end end
                end
            end
        end
    else
        if chamsBody[plr] then dropChams(plr) end
        local hl = chamsHL[plr]
        if not hl or not hl.Parent then
            hl = Instance.new("Highlight")
            hl.Name="secret_chams"; hl.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
            hl.Parent=ch; chamsHL[plr]=hl
        end
        hl.Adornee = ch
        hl.FillColor = VIS.chams.fill_color
        hl.FillTransparency = VIS.chams.fill_transparency
        hl.OutlineColor = VIS.chams.outline_color
        hl.OutlineTransparency = VIS.chams.outline_transparency
    end
end

local lastChams = 0
RunService.Heartbeat:Connect(function()
    if not VIS.chams.enable then
        for p in pairs(chamsHL) do dropChams(p) end
        for p in pairs(chamsBody) do dropChams(p) end
        return
    end
    local now = tick()
    if now - lastChams < 0.2 then return end
    lastChams = now
    for _, plr in ipairs(Players:GetPlayers()) do if plr ~= LocalPlayer then applyChams(plr) end end
end)

