local chSpin, chClock = 0, 0

local function local_speed()
    local ch = LocalPlayer.Character
    local root = ch and ch:FindFirstChild("HumanoidRootPart")
    if not root then return 0 end
    local v = root.AssemblyLinearVelocity
    return Vector2.new(v.X, v.Z).Magnitude
end

local function ch_anchor()
    local c = VIS.crosshair
    if c.follow_target then
        if c.follow_source == "gunpoint" then
            local fp = workspace:FindFirstChild("ViewModels")
            local first = fp and fp:FindFirstChild("FirstPerson")
            if first then
                for _, p in ipairs(first:GetDescendants()) do
                    if p.Name == "_muzzle" and p:IsA("Attachment") then
                        local sp = Camera:WorldToViewportPoint(p.WorldPosition)
                        return Vector2.new(sp.X, sp.Y)
                    end
                end
            end
        else
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= LocalPlayer and plr.Character then
                    local part = plr.Character:FindFirstChild("Head") or plr.Character:FindFirstChild("HumanoidRootPart")
                    if part then
                        local sp, on = Camera:WorldToViewportPoint(part.Position)
                        if on then return Vector2.new(sp.X, sp.Y) end
                    end
                end
            end
        end
    end
    local vp = Camera.ViewportSize
    return Vector2.new(vp.X/2, vp.Y/2)
end

local function hideCrosshair()
