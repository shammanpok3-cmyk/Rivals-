local function adapt(ctrl, opts)
    opts = opts or {}
    local proxy = { _ctrl = ctrl, _type = opts.Type or "Generic" }

    local function getValue()
        if ctrl.Get then
            local ok, v = pcall(ctrl.Get, ctrl)
            if ok then return v end
        end
        return opts.Default
    end
    local function setValue(v)
        if ctrl.Set then pcall(ctrl.Set, ctrl, v) end
    end

    setmetatable(proxy, {
        __index = function(_, k)
            if k == "Value"      then return getValue() end
            if k == "SetValue"   then return function(_, v) setValue(v) end end
            if k == "Set"        then return function(_, v) setValue(v) end end
            if k == "Get"        then return getValue end
            if k == "SetVisible" then return function() end end
            if k == "OnChanged"  then
                return function(_, fn)
                    opts.OnChanged = fn
                    if fn then pcall(fn, getValue()) end
                end
            end
            if k == "UpdateColors" then return function() end end
            if k == "Display"      then return function() end end
            if k == "Type"         then return opts.Type end
            return ctrl[k]
        end,
    })
    return proxy
end

