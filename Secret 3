function SaveManager:SetFolder(folder) self.Folder = folder end

function SaveManager:Save(name)
    if not name or name == "" then return false, "no config name" end
    local ok, err = pcall(function()
        Zolar:SaveConfigFile(name)
    end)
    if not ok then return false, tostring(err) end
    return true
end

function SaveManager:Load(name)
    if not name or name == "" then return false, "no config name" end
    local ok, res = pcall(function()
        return Zolar:LoadConfigFile(name)
    end)
    if not ok then return false, tostring(res) end
    if res == false then return false, "load failed" end
    return true
end

function SaveManager:RefreshConfigList()
    local ok, list = pcall(function() return Zolar:ListConfigs() end)
    if ok and type(list) == "table" then return list end
    return {}
end

function SaveManager:LoadAutoloadConfig()
    local ok, res = pcall(function() return Zolar:LoadAutoloadConfig() end)
    if not ok then return false, tostring(res) end
    return res ~= false
end

function SaveManager:BuildConfigSection(tab)
    local sec = tab:AddRightGroupbox("Configuration")
    sec:AddInput("SaveManager_ConfigName", { Text = "Config name", Default = "" })
    sec:AddDropdown("SaveManager_ConfigList", {
        Text = "Config list",
        Values = self:RefreshConfigList(),
        Default = nil,
    })
    local function refresh()
        local O = Options.SaveManager_ConfigList
        if O and O.SetValues then pcall(O.SetValues, O, SaveManager:RefreshConfigList()) end
    end
    sec:AddButton("Create config", function()
        local n = Options.SaveManager_ConfigName and Options.SaveManager_ConfigName.Value or ""
        if n == "" then return Library:Notify("Invalid config name", 2) end
        local ok, err = SaveManager:Save(n)
        if not ok then return Library:Notify("Save failed: " .. tostring(err), 3) end
        Library:Notify("Created config '" .. n .. "'", 2)
        refresh()
    end)
    sec:AddButton("Load config", function()
        local n = Options.SaveManager_ConfigList and Options.SaveManager_ConfigList.Value
        if not n then return Library:Notify("No config selected", 2) end
        local ok, err = SaveManager:Load(n)
        if not ok then return Library:Notify("Load failed: " .. tostring(err), 3) end
        Library:Notify("Loaded '" .. n .. "'", 2)
    end)
    sec:AddButton("Overwrite config", function()
        local n = Options.SaveManager_ConfigList and Options.SaveManager_ConfigList.Value
        if not n then return Library:Notify("No config selected", 2) end
        SaveManager:Save(n)
        Library:Notify("Overwrote '" .. n .. "'", 2)
    end)
    sec:AddButton("Delete config", function()
        local n = Options.SaveManager_ConfigList and Options.SaveManager_ConfigList.Value
        if not n then return Library:Notify("No config selected", 2) end
        pcall(delfile, SaveManager.Folder .. "/" .. n .. ".json")
        Library:Notify("Deleted '" .. n .. "'", 2)
        refresh()
    end)
    sec:AddButton("Refresh list", refresh)
    sec:AddButton("Set as autoload", function()
        local n = Options.SaveManager_ConfigList and Options.SaveManager_ConfigList.Value
        if not n then return Library:Notify("No config selected", 2) end
        pcall(function() Zolar:SetAutoloadConfig(n) end)
        Library:Notify("Autoload set to '" .. n .. "'", 2)
    end)
    sec:AddButton("Clear autoload", function()
        pcall(function() Zolar:ClearAutoloadConfig() end)
        Library:Notify("Autoload cleared", 2)
    end)
    SaveManager:SetIgnoreIndexes({ "SaveManager_ConfigName", "SaveManager_ConfigList" })
end

getgenv().SaveManager = SaveManager

