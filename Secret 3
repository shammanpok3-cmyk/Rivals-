local function WrapTab(tab)
    local wrapper = { _tab = tab, _sections = {} }

    function wrapper:AddGroupbox(name, side)
        side = side or "Left"
        local sec = tab:Section({ Name = name, Side = side })
        return WrapSection(sec)
    end
    function wrapper:AddLeftGroupbox(name)  return wrapper:AddGroupbox(name, "Left")  end
    function wrapper:AddRightGroupbox(name) return wrapper:AddGroupbox(name, "Right") end
    function wrapper:AddLeftTabbox()  return WrapTabbox(tab, "Left")  end
    function wrapper:AddRightTabbox() return WrapTabbox(tab, "Right") end
    function wrapper:ShowTab() end
    function wrapper:HideTab() end

    return wrapper
end

function WrapSection(sec)
    local wrapper = { _sec = sec }

    function wrapper:AddToggle(idx, info)
        info = info or {}
        local ctrl = sec:Toggle({
            Name     = info.Text or idx,
            Default  = info.Default or false,
            Flag     = idx,
            Callback = info.Callback,
        })
        local proxy = adapt(ctrl, { Type = "Toggle", Default = info.Default })
        Toggles[idx] = proxy
        proxy.AddKeyPicker = function(_, kidx, kinfo)
            kinfo = kinfo or {}
            ctrl:Keybind({
                Default  = kinfo.Default and kinfo.Default ~= "..." and Enum.KeyCode[kinfo.Default] or Enum.KeyCode.Unknown,
                Flag     = kidx,
                Callback = kinfo.Callback,
            })
            local kp = adapt({ Get = function() return ctrl end, Set = function() end }, { Type = "KeyPicker" })
            Options[kidx] = kp
            return proxy
        end
        proxy.AddColorPicker = function(_, cidx, cinfo)
            cinfo = cinfo or {}
            ctrl:Colorpicker({
                Name     = cinfo.Title or cidx,
                Default  = cinfo.Default or Color3.new(1, 1, 1),
                Flag     = cidx,
                Callback = cinfo.Callback,
            })
            local cp = adapt({ Get = function() return cinfo.Default end, Set = function() end }, { Type = "ColorPicker", Default = cinfo.Default })
            Options[cidx] = cp
            return proxy
        end
        return proxy
    end

    function wrapper:AddSlider(idx, info)
        info = info or {}
        local ctrl = sec:Slider({
            Name     = info.Text or idx,
            Min      = info.Min or 0,
            Max      = info.Max or 100,
            Default  = info.Default or 0,
            Decimals = info.Rounding or 0,
            Suffix   = info.Suffix or "",
            Flag     = idx,
            Callback = info.Callback,
        })
        local proxy = adapt(ctrl, { Type = "Slider", Default = info.Default })
        Options[idx] = proxy
        return proxy
    end

    function wrapper:AddDropdown(idx, info)
        info = info or {}
        local ctrl = sec:Dropdown({
            Name     = info.Text or idx,
            Items    = info.Values or {},
            Default  = info.Default,
            Multi    = info.Multi or false,
            Flag     = idx,
            Callback = info.Callback,
        })
        local proxy = adapt(ctrl, { Type = "Dropdown", Default = info.Default })
        proxy.SetValues = function(_, vals) pcall(ctrl.Refresh, ctrl, vals) end
        Options[idx] = proxy
        return proxy
    end

    function wrapper:AddButton(...)
        local args = { ... }
        local info
        if type(args[1]) == "table" then info = args[1]
        else info = { Text = args[1], Func = args[2] } end
        local name = info.Text
        sec:Button({
            Name     = name,
            Callback = info.Func or function() end,
        })
        return { _sec = sec }
    end

    function wrapper:AddInput(idx, info)
        info = info or {}
        local ctrl = sec:Textbox({
            Name        = info.Text or idx,
            Default     = info.Default or "",
            Placeholder = info.Placeholder or "",
            Flag        = idx,
            Callback    = info.Callback,
        })
        local proxy = adapt(ctrl, { Type = "Input", Default = info.Default })
        Options[idx] = proxy
        return proxy
    end

    function wrapper:AddLabel(text, wrap)
        sec:Label({ Name = text })
        return { SetText = function() end }
    end

    function wrapper:AddDivider() end
    function wrapper:AddDependencyBox()
        return {
            SetupDependencies = function() end,
            Container = sec,
            AddToggle = function() end,
        }
    end

    return wrapper
end

local function WrapTabbox(tab, side)
    local wrapper = { _subs = {} }
    function wrapper:AddTab(name)
        local sub = tab:SubTab({ Name = name })
        local subWrapper = {
            _sub = sub,
            AddGroupbox = function(_, gname)
                local sec = sub:Section({ Name = gname or name, Side = side or "Left" })
                return WrapSection(sec)
            end,
            AddLeftGroupbox  = function(_, g) return wrapper:AddTab(name):AddGroupbox(g) end,
            AddRightGroupbox = function(_, g) return wrapper:AddTab(name):AddGroupbox(g) end,
        }
        subWrapper.AddToggle   = function(_, i, inf) return WrapSection(sub:Section({Name = name})):AddToggle(i, inf) end
        subWrapper.AddSlider   = function(_, i, inf) return WrapSection(sub:Section({Name = name})):AddSlider(i, inf) end
        subWrapper.AddDropdown = function(_, i, inf) return WrapSection(sub:Section({Name = name})):AddDropdown(i, inf) end
        subWrapper.AddButton   = function(...) return WrapSection(sub:Section({Name = name})):AddButton(...) end
        subWrapper.AddInput    = function(_, i, inf) return WrapSection(sub:Section({Name = name})):AddInput(i, inf) end
        subWrapper.AddLabel    = function(_, t, w) return WrapSection(sub:Section({Name = name})):AddLabel(t, w) end
        subWrapper.AddDivider  = function() end
        subWrapper.AddToggle   = function() end
        return subWrapper
    end
    return wrapper
end

